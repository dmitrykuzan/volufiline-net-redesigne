<script>
  // OPTIONAL: "single page" behavior — blocks most navigation out of this page.
  // Remove if you don't want it this strict.
  (function () {
    var root = document.querySelector('[data-rebrand-page]');
    if (!root) return;

    // Kill theme header/footer if they still appear (some themes inject via JS)
    var header = document.querySelector('header, .header, #shopify-section-header');
    var footer = document.querySelector('footer, .footer, #shopify-section-footer');
    if (header) header.style.display = 'none';
    if (footer) footer.style.display = 'none';

    // Prevent clicking links that aren't allowed
    var ALLOW = [
      'https://volumize.us',
      'https://cancel.volufiline.us/login?store=jg3v04-dq',
      'mailto:info@volufiline.us',
      'tel:+15134499947'
    ];

    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a');
      if (!a) return;

      var href = (a.getAttribute('href') || '').trim();
      if (!href) return;

      // allow anchor links inside the page
      if (href.startsWith('#')) return;

      // allow exact matches + tel/mailto
      if (ALLOW.includes(href) || href.startsWith('mailto:') || href.startsWith('tel:')) return;

      e.preventDefault();
      e.stopPropagation();
    }, true);

    // Optional: discourage back button loops (won’t fully stop it in all browsers)
    history.pushState(null, '', location.href);
    window.addEventListener('popstate', function () {
      history.pushState(null, '', location.href);
    });
  })();
</script>

