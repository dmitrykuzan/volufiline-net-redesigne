<style>
  /* -------------------------
     Fonts (loaded from assets)
     Make sure these files exist in /assets
  -------------------------- */

  /* Bold */
  @font-face {
    font-family: 'Maison Neue';
    src: url('{{ "fonnts.com-Maison_Neue_Bold.ttf" | asset_url }}') format('truetype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  /* Book (Regular) */
  @font-face {
    font-family: 'Maison Neue';
    src: url('{{ "fonnts.com-Maison_Neue_Book.ttf" | asset_url }}') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  /* Light */
  @font-face {
    font-family: 'Maison Neue';
    src: url('{{ "fonnts.com-Maison_Neue_Light.ttf" | asset_url }}') format('truetype');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }

  /* Mono */
  @font-face {
    font-family: 'Maison Neue Mono';
    src: url('{{ "fonnts.com-Maison_Neue_Mono.ttf" | asset_url }}') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  :root{
    --rb-font: 'Maison Neue', system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    --rb-mono: 'Maison Neue Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  }

  .rb-wrap{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#f6f7fb;
    padding:32px 16px;
    font-family: var(--rb-font);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .rb-card{
    width:min(900px, 100%);
    background:#fff;
    border:1px solid rgba(0,0,0,.08);
    border-radius:18px;
    box-shadow:0 18px 60px rgba(0,0,0,.10);
    padding:34px 34px 28px;
    position:relative;
  }

  .rb-brand{
    text-align:center;
    margin-bottom:14px;
  }
  .rb-brand h1{
    font-size:32px;
    line-height:1.15;
    margin:0 0 8px;
    font-weight:700;
    letter-spacing:-.02em;
    color:#0d1321;
  }
  .rb-brand p{
    margin:0;
    font-size:16px;
    font-weight:400;
    color:rgba(13,19,33,.75);
  }

  .rb-divider{
    height:1px;
    background:rgba(0,0,0,.08);
    margin:18px 0 18px;
  }

  .rb-body{
    font-size:16px;
    line-height:1.65;
    font-weight:400;
    color:rgba(13,19,33,.9);
  }
  .rb-body strong{ color:#0d1321; font-weight:700; }

  .rb-mono{
    font-family: var(--rb-mono);
    font-weight:400;
    letter-spacing:.02em;
  }

  .rb-cta{
    display:flex;
    gap:12px;
    flex-wrap:wrap;
    margin-top:18px;
    justify-content:center;
  }
  .rb-btn{
    appearance:none;
    border:none;
    border-radius:12px;
    padding:12px 16px;
    font-weight:700;
    font-size:15px;
    cursor:pointer;
    text-decoration:none;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    transition:transform .05s ease, opacity .15s ease;
    font-family: var(--rb-font);
  }
  .rb-btn:active{ transform:translateY(1px); }
  .rb-btn.primary{
    background:#111827;
    color:#fff;
  }
  .rb-btn.secondary{
    background:#f3f4f6;
    color:#111827;
    border:1px solid rgba(0,0,0,.10);
  }

  .rb-support{
    margin-top:18px;
    background:#f7fafc;
    border:1px solid rgba(0,0,0,.06);
    border-radius:14px;
    padding:16px 18px;
  }
  .rb-support h2{
    font-size:16px;
    margin:0 0 10px;
    color:#111827;
    font-weight:700;
  }
  .rb-support a{
    color:#0b5fff;
    text-decoration:none;
    font-weight:700;
    font-family: var(--rb-font);
  }
  .rb-support a:hover{ text-decoration:underline; }

  .rb-grid{
    display:grid;
    gap:8px;
  }
  .rb-row{
    display:flex;
    gap:10px;
    align-items:flex-start;
    justify-content:space-between;
    flex-wrap:wrap;
  }
  .rb-label{ color:rgba(17,24,39,.65); font-weight:700; }
  .rb-value{ color:#111827; font-weight:700; }

  .rb-foot{
    margin-top:16px;
    text-align:center;
    color:rgba(17,24,39,.55);
    font-size:13px;
    font-weight:400;
  }
</style>

